#!/bin/sh
# Template for the global pre-commit and pre-merge-commit hooks; `hal setup`
# renders it with the absolute path below. Edit the template, not a copy.
# git runs the hook in the work tree, where quality scans what the commit records.
# quality finds mise on PATH, which a git client may not carry, so only its call gets hal's mise directory.
quality=@QUALITY@
mise_directory=@MISE_DIRECTORY@
hook=${0##*/}

scan_staged() {
    PATH="$PATH:$mise_directory" "$quality" check secrets --staged
}

if [ ! -x "$quality" ]; then
    echo "$hook: quality fehlt ($quality), Commit gesperrt. Einrichten: hal setup" >&2
    exit 2
fi

scan_staged || exit $?

# A repository hook may stage files and only the final index is committed, so it is
# followed by a second scan. The guard stops a repository hook that is a copy of this one.
if [ -z "$HOME_GIT_HOOK_CHAINED" ]; then
    repository_hook="$(git rev-parse --git-common-dir)/hooks/$hook"
    if [ -x "$repository_hook" ]; then
        HOME_GIT_HOOK_CHAINED=1 "$repository_hook" "$@" || exit $?
        scan_staged
        exit $?
    fi
fi
exit 0
