// The operator may stop the tunnel without a password, also over SSH; nothing else is granted
// here, so `start`, `restart` and every other unit still ask. polkit's engine is ES5.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "cloudflared.service" &&
        action.lookup("verb") == "stop" &&
        subject.user == "@OPERATOR_USER@") {
        return polkit.Result.YES;
    }
});
