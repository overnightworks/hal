#!/usr/bin/env python3
"""Keycloak go-live as one command (docs/keycloak.md, "Go-live"): the operator's tool.

Runs steps 2-6 (as `--help` numbers them) and the end of step 7, asks for the operator's admin
name and first password (step 6), and stops for the human part, the browser (TOTP and passkey,
step 7). It ends unpublished: its last line names `hal apply`. Every step checks its own
done-state first, so a run after an interruption continues at the first unfinished step. No secret
is printed: command output is captured and a failure shows one scrubbed line.

    keycloak/go-live
    keycloak/go-live --check
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import secrets
import subprocess
import sys
import textwrap
import time
import warnings
from collections.abc import Callable, Iterator
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path
from urllib.error import HTTPError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "src"))  # the emergency switch has one owner: hal.stack.switches

from hal.backup import runner as backup_runner  # noqa: E402
from hal.backup.settings import Settings as BackupSettings  # noqa: E402
from hal.stack import switches  # noqa: E402

SECRET_FILES = ("db-password", "config-cli-secret", "bootstrap-admin-password")
BOOTSTRAP_SECRET = "bootstrap-admin-password"
UNIT = "keycloak"  # the catalog key of the unit, and so the name of its switch marker
BOOTSTRAP_ADMIN = "temp-admin"
BOOTSTRAP_OVERLAY = "keycloak/bootstrap.compose.yaml"
KEYCLOAK_PROFILE = "keycloak"
# keycloak-config-cli lives behind it, and so do the client secrets it reads
APPLY_PROFILE = "apply"
CLIENT_SECRETS_DIR = "clients"
CLIENT_ID = re.compile(r"[a-z0-9][a-z0-9-]*")
BOOTSTRAP_ENV = "KC_BOOTSTRAP_ADMIN_USERNAME"
DATABASE_VOLUME = "keycloak-db"
ADMIN_URL = "http://localhost:8090"
EDGE_URL = "http://127.0.0.1:8081"
MASTER_ISSUER = f"{ADMIN_URL}/realms/master"
MASTER_TOKEN_URL = f"{MASTER_ISSUER}/protocol/openid-connect/token"
ADMIN_REALMS = f"{ADMIN_URL}/admin/realms"
IMPORT_CHECKSUM_PREFIX = (
    "de.adorsys.keycloak.config.import-checksum"  # keycloak-config-cli writes it last
)
PUBLIC_HOST = "auth.hallucinai.de"
PUBLIC_REALM = "hallucinai"
CONFIG_CLIENT = "config-cli"
ADMIN_ROLE = "admin"
ADMIN_REQUIRED_ACTIONS = ["CONFIGURE_TOTP", "webauthn-register"]
FACTORS = {"otp": "TOTP credential", "webauthn": "passkey"}  # Keycloak's credential types
NO_SUCH_VOLUME = "no such volume"  # docker's answer for a volume that is absent
READY_TIMEOUT_SECONDS = 240
LONG_COMMAND_SECONDS = 900
SHORT_COMMAND_SECONDS = 60
HTTP_SECONDS = 15
POLL_SECONDS = 2
YES = ("y", "yes")
NO = ("n", "no")

# Runs inside the keycloak container, which has bash but no curl: one plain HTTP/1.0 GET on
# Keycloak's own port, before any Traefik entrypoint exists.
CONTAINER_GET = (
    "exec 3<>/dev/tcp/127.0.0.1/8080 && "
    "printf 'GET %s HTTP/1.0\\r\\nHost: localhost:8080\\r\\n\\r\\n' \"$1\" >&3 && cat <&3"
)

# Also inside the container, for the same reason: the admin API is reachable from the host only
# through the edge, which does not stand yet while the apply is being checked. The client secret
# arrives on standard input, so it is in no command line.
CONTAINER_REALM_ATTRIBUTES = (
    "IFS= read -r KC_CLI_CLIENT_SECRET && export KC_CLI_CLIENT_SECRET && "
    'exec /opt/keycloak/bin/kcadm.sh get "realms/$1" --no-config --server http://localhost:8080 '
    "--realm master --client config-cli --fields attributes"
)

NEXT_STEP = f"Last: `hal apply` publishes {PUBLIC_HOST} once the catalog declares it."


class StepFailure(Exception):
    """A step cannot finish; the message says why in one line."""


class DockerDidNotAnswer(StepFailure):
    """Docker or Compose gave no usable answer: nothing can be said about the installation."""


@dataclass(frozen=True)
class Reply:
    status: int
    body: bytes


def fetch(
    method: str,
    url: str,
    *,
    headers: dict[str, str] | None = None,
    form: dict[str, str] | None = None,
    json_body: object | None = None,
) -> Reply:
    request_headers = dict(headers or {})
    data = urlencode(form).encode() if form is not None else None
    if json_body is not None:
        data = json.dumps(json_body).encode()
        request_headers["Content-Type"] = "application/json"
    request = Request(url, data=data, method=method, headers=request_headers)
    try:
        with urlopen(request, timeout=HTTP_SECONDS) as reply:
            return Reply(reply.status, reply.read())
    except HTTPError as error:
        return Reply(error.code, error.read())


def run_command(
    command: list[str], timeout: int, stdin: str | None = None
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
            cwd=REPO,
            input=stdin,
        )
    except subprocess.TimeoutExpired as error:
        raise DockerDidNotAnswer(
            f"`{' '.join(command[:3])}` took longer than {timeout}s"
        ) from error
    except OSError as error:
        raise DockerDidNotAnswer(f"cannot run {command[0]}: {error.strerror}") from error


def ask_without_echo(prompt: str, read: Callable[[str], str] = getpass.getpass) -> str:
    """getpass, but never its fallback: without a terminal it would read the password echoed."""
    with warnings.catch_warnings():
        warnings.simplefilter("error", getpass.GetPassWarning)
        try:
            return read(prompt)
        except getpass.GetPassWarning as warning:
            raise StepFailure("no terminal for the password") from warning


def new_secret_value() -> str:
    return secrets.token_hex(32)


def edge_backup_is_set_up() -> bool:
    """`hal backup`'s own check; anything unclear reads as not set up, so the question is asked."""
    settings = BackupSettings.for_home(Path.home(), os.getuid(), os.getgid())
    try:
        backup_runner.require_secret_and_repository(settings)
    except (backup_runner.StepFailed, OSError):
        return False
    return True


@dataclass(frozen=True)
class Tools:
    """Everything outside the script's logic: processes, HTTP, the operator, the clock."""

    run: Callable[..., subprocess.CompletedProcess[str]] = run_command
    fetch: Callable[..., Reply] = fetch
    ask: Callable[[str], str] = input
    ask_hidden: Callable[[str], str] = ask_without_echo
    default_user: Callable[[], str] = getpass.getuser
    say: Callable[[str], None] = print
    sleep: Callable[[float], None] = time.sleep
    monotonic: Callable[[], float] = time.monotonic
    new_secret: Callable[[], str] = new_secret_value
    backup_is_set_up: Callable[[], bool] = edge_backup_is_set_up


@dataclass(frozen=True)
class Step:
    number: str  # the step number `--help` prints
    name: str
    is_done: Callable[[], bool]
    do: Callable[[], None]
    why: str  # what happens now and why, in plain words: printed before the step, listed by --help


class GoLive:
    def __init__(self, tools: Tools, secrets_dir: Path, marks: switches.Switches) -> None:
        self.tools = tools
        self.secrets_dir = secrets_dir
        self.marks = marks
        self.typed_secrets: list[str] = []  # what the operator typed: scrubbed from every failure
        self.created_admin: str | None = None  # the admin step 6 made in this run

    # --- the emergency switch (docs/keycloak.md, "Go-live") ---------------------

    def switched_off_reason(self) -> str | None:
        since = self.marks.since(UNIT)
        if since is None:
            return None
        return (
            f"{UNIT} is switched off (since {switches.describe_since(since)}); "
            f"`hal start {UNIT}` ends the switch"
        )

    @contextmanager
    def starting(self) -> Iterator[None]:
        """Around a command that starts containers: the marker is read under the switch lock, so
        a stop made meanwhile wins. Never held while a prompt or the browser step waits."""
        try:
            with self.marks.lock():
                reason = self.switched_off_reason()
                if reason:
                    raise StepFailure(reason)
                yield
        except switches.SwitchError as error:
            raise StepFailure(str(error)) from error

    # --- secrets (step 2) -----------------------------------------------------------------

    def missing_secrets(self) -> list[str]:
        return [name for name in SECRET_FILES if not (self.secrets_dir / name).exists()]

    def secrets_are_complete(self) -> bool:
        """All three, or none (to be created). Only the bootstrap file may be missing, and only
        once the database volume exists: step 7 deletes the file, and `docker compose down`
        leaves the database behind. On a fresh install Keycloak would set up the empty database
        without temp-admin, which nothing recovers from. Whether temp-admin is really gone is
        step 7's question, and a master that has not moved without the file is step 4a's
        refusal."""
        missing = self.missing_secrets()
        if not missing:
            return True
        if len(missing) == len(SECRET_FILES):
            return False
        if missing == [BOOTSTRAP_SECRET]:
            if self.database_volume_exists():
                return True
            raise StepFailure(
                f"the database volume {DATABASE_VOLUME} is missing although {BOOTSTRAP_SECRET} "
                "is gone: go-live cannot finish on an empty database; restore the volume"
            )
        raise StepFailure(f"some secret files exist, missing: {', '.join(missing)}")

    def create_secrets(self) -> None:
        self.secrets_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.secrets_dir.chmod(0o700)
        for name in SECRET_FILES:
            self.create_secret_file(self.secrets_dir / name)

    def create_secret_file(self, path: Path) -> None:
        # O_EXCL: an existing file is never overwritten. The container users must read the
        # file; the 0700 directory keeps everyone else out.
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        try:
            with os.fdopen(descriptor, "w") as secret_file:
                os.fchmod(secret_file.fileno(), 0o644)
                secret_file.write(self.tools.new_secret())
        except BaseException:
            # An empty file would read as done on the next run; only this call's file goes.
            path.unlink()
            raise

    # --- client secrets (step 2b): compose names the clients, go-live creates the files --------

    @property
    def client_secrets_dir(self) -> Path:
        return self.secrets_dir / CLIENT_SECRETS_DIR

    def client_ids(self) -> list[str]:
        config = self.compose(
            "config",
            "--format",
            "json",
            bootstrap=False,
            profiles=(KEYCLOAK_PROFILE, APPLY_PROFILE),
        )
        if config.returncode != 0:
            raise DockerDidNotAnswer(self.failure_line("config", config))
        prefix = f"{self.client_secrets_dir}/"
        declared = json.loads(config.stdout).get("secrets", {}).values()
        files = [secret["file"] for secret in declared if "file" in secret]
        client_ids = [file.removeprefix(prefix) for file in files if file.startswith(prefix)]
        for client_id in client_ids:
            if not CLIENT_ID.fullmatch(client_id):
                raise StepFailure(
                    f"compose names the client secret file {prefix}{client_id}; a client id is "
                    "lower-case letters, digits and hyphens, so fix compose.yaml"
                )
        return client_ids

    def missing_client_ids(self) -> list[str]:
        return [
            client_id
            for client_id in self.client_ids()
            if not (self.client_secrets_dir / client_id).exists()
        ]

    def client_secrets_are_complete(self) -> bool:
        return not self.missing_client_ids()

    def create_client_secrets(self) -> None:
        self.client_secrets_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.client_secrets_dir.chmod(0o700)
        for client_id in self.missing_client_ids():
            self.create_secret_file(self.client_secrets_dir / client_id)

    def secret_values(self) -> list[str]:
        """What can be read: a file that cannot be read cannot leak into a failure line either."""
        paths = [self.secrets_dir / name for name in SECRET_FILES]
        if self.client_secrets_dir.is_dir():
            paths += sorted(self.client_secrets_dir.iterdir())
        values = []
        for path in paths:
            try:
                values.append(path.read_text().strip())
            except OSError:
                continue
        return [value for value in values if value]

    def scrubbed(self, text: str) -> str:
        for value in [*self.secret_values(), *self.typed_secrets]:
            text = text.replace(value, "***")
        return text

    # --- docker compose -------------------------------------------------------------------

    def database_volume_exists(self) -> bool:
        # Compose names the volume (project name, COMPOSE_PROJECT_NAME and all); ask it.
        config = self.compose("config", "--format", "json", bootstrap=False)
        if config.returncode != 0:
            raise DockerDidNotAnswer(self.failure_line("config", config))
        volume_name = json.loads(config.stdout)["volumes"][DATABASE_VOLUME]["name"]
        inspected = self.tools.run(
            ["docker", "volume", "inspect", volume_name], SHORT_COMMAND_SECONDS
        )
        if inspected.returncode == 0:
            return True
        if NO_SUCH_VOLUME in inspected.stderr.lower():
            return False
        raise DockerDidNotAnswer(self.failure_line("volume inspect", inspected, tool="docker"))

    def bootstrap_present(self) -> bool:
        return (self.secrets_dir / BOOTSTRAP_SECRET).exists()

    def compose(
        self,
        *args: str,
        bootstrap: bool,
        timeout: int = LONG_COMMAND_SECONDS,
        stdin: str | None = None,
        profiles: tuple[str, ...] = (KEYCLOAK_PROFILE,),
    ):
        command = ["docker", "compose", "--project-directory", str(REPO), "--file", "compose.yaml"]
        for profile in profiles:
            command += ["--profile", profile]
        if bootstrap:
            command += ["--file", BOOTSTRAP_OVERLAY]
        return self.tools.run([*command, *args], timeout, stdin)

    def compose_must(
        self, *args: str, bootstrap: bool = False, timeout: int = LONG_COMMAND_SECONDS
    ):
        result = self.compose(*args, bootstrap=bootstrap, timeout=timeout)
        if result.returncode != 0:
            raise StepFailure(self.failure_line(args[0], result))
        return result

    def failure_line(
        self, what: str, result: subprocess.CompletedProcess[str], tool: str = "docker compose"
    ) -> str:
        lines = [line for line in (result.stderr + result.stdout).splitlines() if line.strip()]
        last = self.scrubbed(lines[-1].strip()) if lines else "no output"
        return f"`{tool} {what}` exited {result.returncode}: {last}"

    def container_get(self, path: str) -> Reply | None:
        result = self.compose(
            "exec", "-T", "keycloak", "bash", "-c", CONTAINER_GET, "bash", path,
            bootstrap=False, timeout=SHORT_COMMAND_SECONDS,
        )  # fmt: skip
        # Text mode folds the CRLFs into newlines.
        head, separator, body = result.stdout.partition("\n\n")
        status_line = head.splitlines()[0].split() if head else []
        if result.returncode != 0 or not separator or len(status_line) < 2:
            return None
        return Reply(int(status_line[1]), body.encode())

    def keycloak_answers(self) -> bool:
        reply = self.container_get("/realms/master")
        return reply is not None and reply.status == 200

    def master_issuer(self) -> str | None:
        reply = self.container_get("/realms/master/.well-known/openid-configuration")
        if reply is None or reply.status != 200:
            return None
        return json.loads(reply.body).get("issuer")

    def keycloak_runs_with_overlay(self) -> bool:
        container = self.compose(
            "ps", "-q", "keycloak", bootstrap=False, timeout=SHORT_COMMAND_SECONDS
        )
        container_id = container.stdout.strip()
        if container.returncode != 0 or not container_id:
            return True
        inspected = self.tools.run(
            ["docker", "inspect", "--format", "{{json .Config.Env}}", container_id],
            SHORT_COMMAND_SECONDS,
        )
        if inspected.returncode != 0:
            return True
        return any(entry.startswith(f"{BOOTSTRAP_ENV}=") for entry in json.loads(inspected.stdout))

    def becomes_true_in_time(self, condition: Callable[[], bool]) -> bool:
        deadline = self.tools.monotonic() + READY_TIMEOUT_SECONDS
        while not condition():
            if self.tools.monotonic() >= deadline:
                return False
            self.tools.sleep(POLL_SECONDS)
        return True

    def wait_until(self, condition: Callable[[], bool], what: str) -> None:
        if not self.becomes_true_in_time(condition):
            raise StepFailure(f"{what} not ready after {READY_TIMEOUT_SECONDS}s")

    def edge_is_ready(self) -> bool:
        """docs/stack.md "Start, readiness, stop": unknown host 404 on 8081, master on 8090."""
        try:
            unknown = self.tools.fetch("GET", f"{EDGE_URL}/", headers={"Host": "unknown.invalid"})
            master = self.tools.fetch("GET", f"{ADMIN_URL}/realms/master")
        except OSError:
            return False
        return unknown.status == 404 and master.status == 200

    # --- steps ----------------------------------------------------------------------------

    @staticmethod
    def typed(ask: Callable[[str], str], prompt: str) -> str:
        try:
            return ask(prompt)
        except EOFError as error:
            raise StepFailure("no answer on standard input") from error

    def ask_yes_no(self, question: str) -> bool:
        while True:
            answer = self.typed(self.tools.ask, f"{question} [yes/no] ").strip().lower()
            if answer in YES + NO:
                return answer in YES

    def confirm_no_backup(self) -> None:
        if not self.ask_yes_no(
            "hal backup is not set up on this PC, so Keycloak's data will not be backed up. "
            "Continue without the Keycloak backup?"
        ):
            raise StepFailure("stopped: no backup yet and you did not accept that")

    def start_keycloak(self) -> None:
        with self.starting():
            self.compose_must("up", "-d", "keycloak", bootstrap=self.bootstrap_present())
        self.wait_until(self.keycloak_answers, "Keycloak")

    def master_is_moved(self) -> bool:
        return self.master_issuer() == MASTER_ISSUER

    def move_master(self) -> None:
        if not self.bootstrap_present():
            raise StepFailure(f"{BOOTSTRAP_SECRET} is gone but master is not on {ADMIN_URL}")
        self.compose_must(
            "exec", "-T", "keycloak", "/opt/edge/admin-frontend.sh", bootstrap=True,
            timeout=SHORT_COMMAND_SECONDS,
        )  # fmt: skip

    def apply_realms(self) -> None:
        """First with temp-admin; once master.yaml is applied that grant demands TOTP (401), so
        the second try signs in as the config-cli client, as every later apply does."""
        args = ("run", "--rm", "keycloak-config-cli")
        if self.bootstrap_present():
            with self.starting():  # `run` starts keycloak through depends_on
                first = self.compose(*args, bootstrap=True)
            if first.returncode == 0:
                return
        with self.starting():
            self.compose_must(*args)

    def realm_import_completed(self) -> bool:
        """The realm existing proves nothing: keycloak-config-cli creates it first and records its
        import checksum as a realm attribute only after the clients, scopes and groups are in.
        Once the edge stands, the container's own kcadm is refused (401) and the admin door is
        the way in. The config-cli client the door needs exists only after the first apply, so a
        refused sign-in there means the import has not completed."""
        if not self.keycloak_runs_with_overlay():
            # Step 5 has begun, so 8090 is the door that is about to answer. A run that stopped
            # because the edge would not start gets no answer: it reads the container's door.
            self.becomes_true_in_time(self.edge_is_ready)
        if self.edge_is_ready():
            token = self.config_cli_token()
            if token is None:
                return False
            attributes = self.realm_attributes_by_admin_api(token)
        else:
            attributes = self.realm_attributes_in_container()
        return any(key.startswith(IMPORT_CHECKSUM_PREFIX) for key in attributes)

    def realm_attributes_by_admin_api(self, token: str) -> dict[str, str]:
        reply = self.tools.fetch(
            "GET", f"{ADMIN_REALMS}/{PUBLIC_REALM}", headers={"Authorization": f"Bearer {token}"}
        )
        if reply.status == 404:
            return {}
        if reply.status != 200:
            raise StepFailure(f"the admin API answered {reply.status} to GET realm {PUBLIC_REALM}")
        return json.loads(reply.body).get("attributes", {})

    def realm_attributes_in_container(self) -> dict[str, str]:
        client_secret = (self.secrets_dir / "config-cli-secret").read_text().strip()
        reply = self.compose(
            "exec", "-T", "keycloak", "bash", "-c", CONTAINER_REALM_ATTRIBUTES, "bash",
            PUBLIC_REALM, bootstrap=False, timeout=SHORT_COMMAND_SECONDS,
            stdin=client_secret + "\n",
        )  # fmt: skip
        if reply.returncode != 0:
            return {}
        return json.loads(reply.stdout).get("attributes", {})

    def edge_runs_without_overlay(self) -> bool:
        return not self.keycloak_runs_with_overlay() and self.edge_is_ready()

    def start_edge(self) -> None:
        with self.starting():
            self.compose_must("up", "-d")
        with self.starting():  # a stop recorded during the first command must win here
            self.compose_must("up", "-d", "--force-recreate", "socket-proxy", "traefik")
        self.wait_until(self.edge_is_ready, "the edge")

    # --- the admin API ---------------------------------------------------------------------

    def admin_reply(
        self,
        token: str,
        method: str,
        path: str,
        *,
        realm: str = "master",
        json_body: object | None = None,
    ) -> Reply:
        return self.tools.fetch(
            method,
            f"{ADMIN_REALMS}/{realm}{path}",
            headers={"Authorization": f"Bearer {token}"},
            json_body=json_body,
        )

    def admin_call(
        self,
        token: str,
        method: str,
        path: str,
        *,
        realm: str = "master",
        json_body: object | None = None,
        accepted: tuple[int, ...] = (200, 204),
    ) -> object:
        reply = self.admin_reply(token, method, path, realm=realm, json_body=json_body)
        if reply.status not in accepted:
            raise StepFailure(f"the admin API answered {reply.status} to {method} {path}")
        return json.loads(reply.body) if reply.body else None

    def admin_token(self) -> str:
        token = self.config_cli_token()
        if token is None:
            raise StepFailure(f"the {CONFIG_CLIENT} sign-in was refused")
        return token

    def config_cli_token(self) -> str | None:
        """The config-cli service account holds the admin role; temp-admin's own password grant
        demands a TOTP code since the first apply, and the script has none. None: refused."""
        client_secret = (self.secrets_dir / "config-cli-secret").read_text().strip()
        reply = self.tools.fetch(
            "POST",
            MASTER_TOKEN_URL,
            form={
                "grant_type": "client_credentials",
                "client_id": CONFIG_CLIENT,
                "client_secret": client_secret,
            },
        )
        if reply.status == 401:
            return None
        if reply.status != 200:
            raise StepFailure(f"the {CONFIG_CLIENT} sign-in answered {reply.status}")
        return json.loads(reply.body)["access_token"]

    def service_account_ids(self, token: str) -> set[str]:
        """The ids of the master users that are a client's service account. Neither the role
        listing nor the full user representation says so; only the client's own link does."""
        clients = self.admin_call(token, "GET", "/clients?max=1000")
        return {
            self.admin_call(token, "GET", f"/clients/{client['id']}/service-account-user")["id"]
            for client in clients
            if client.get("serviceAccountsEnabled")
        }

    def admin_people(self, token: str) -> list[dict]:
        """The enabled master users with the realm role admin who are people: not temp-admin and
        no service account. Step 6 asks whether there is one, step 7 whether one has both
        factors."""
        holders = self.admin_call(token, "GET", f"/roles/{ADMIN_ROLE}/users?max=1000")
        machines = self.service_account_ids(token)
        return [
            user
            for user in holders
            if user["username"] != BOOTSTRAP_ADMIN
            and user["id"] not in machines
            and user["enabled"]
        ]

    def user_named(self, token: str, username: str) -> list[dict]:
        return self.admin_call(token, "GET", f"/users?username={quote(username)}&exact=true")

    # --- step 6: the operator's admin -----------------------------------------------------

    def admin_exists(self) -> bool:
        return self.bootstrap_retired() or bool(self.admin_people(self.admin_token()))

    def ask_admin_name(self) -> str:
        default = self.tools.default_user()
        while True:
            answer = self.typed(self.tools.ask, f"User name of your admin [{default}]: ")
            name = default if answer == "" else answer.strip()
            if name:
                return name.lower()
            self.tools.say("The user name must not be empty.")

    def ask_admin_password(self) -> str:
        while True:
            first = self.typed(self.tools.ask_hidden, "First password for your admin: ")
            again = self.typed(self.tools.ask_hidden, "The same password again: ")
            if first and first == again:
                self.typed_secrets.append(first)
                return first
            self.tools.say("The two passwords differ or are empty; type them again.")

    def create_admin(self) -> None:
        username = self.ask_admin_name()
        password = self.ask_admin_password()
        token = self.admin_token()
        created = self.admin_reply(
            token,
            "POST",
            "/users",
            json_body={
                "username": username,
                "enabled": True,
                "requiredActions": ADMIN_REQUIRED_ACTIONS,
                "credentials": [{"type": "password", "value": password, "temporary": False}],
            },
        )
        if created.status == 409:
            raise StepFailure(
                f"the user {username} exists already; choose another name, or delete it in the "
                f"console at {ADMIN_URL}/admin/"
            )
        if created.status != 201:
            raise StepFailure(f"the admin API answered {created.status} to POST /users")
        try:
            self.map_admin_role(token, username)
        except BaseException:
            self.delete_unfinished_admin(token, username)
            raise
        self.created_admin = username

    def map_admin_role(self, token: str, username: str) -> None:
        user_id = self.user_named(token, username)[0]["id"]
        role = self.admin_call(token, "GET", f"/roles/{ADMIN_ROLE}")
        self.admin_call(
            token, "POST", f"/users/{user_id}/role-mappings/realm", json_body=[role],
            accepted=(204,),
        )  # fmt: skip

    def delete_unfinished_admin(self, token: str, username: str) -> None:
        """The id is looked up again: the failure may have come before it was known."""
        try:
            for user in self.user_named(token, username):
                self.admin_call(token, "DELETE", f"/users/{user['id']}")
        except StepFailure as refused:
            raise StepFailure(
                f"the role {ADMIN_ROLE} could not be set and {username} could not be deleted "
                f"again; delete it in the console at {ADMIN_URL}/admin/"
            ) from refused

    # --- step 7: retire the bootstrap -----------------------------------------------------

    def require_second_admin_with_both_factors(self, token: str) -> None:
        people = self.admin_people(token)
        if not people:
            raise StepFailure(
                f"refusing to retire {BOOTSTRAP_ADMIN}: no other enabled master user has the "
                f"realm role {ADMIN_ROLE}"
            )
        lacking = []
        for person in people:
            credentials = self.admin_call(token, "GET", f"/users/{person['id']}/credentials")
            types = {credential["type"] for credential in credentials}
            missing = [name for kind, name in FACTORS.items() if kind not in types]
            if not missing:
                return
            lacking.append(
                f"{person['username']} has the role {ADMIN_ROLE} but no {' and no '.join(missing)}"
            )
        raise StepFailure(f"refusing to retire {BOOTSTRAP_ADMIN}: {'; '.join(lacking)}")

    def bootstrap_retired(self) -> bool:
        """Step 7 ran: the password file is gone and temp-admin no longer exists."""
        if self.bootstrap_present():
            return False
        return not self.user_named(self.admin_token(), BOOTSTRAP_ADMIN)

    def retire_bootstrap(self) -> None:
        if self.created_admin:
            who = (
                f"as {self.created_admin} with the password you typed; Keycloak asks for a TOTP "
                "code to enrol and for a passkey to add"
            )
        else:
            people = self.admin_people(self.admin_token())
            names = ", ".join(person["username"] for person in people)
            who = f"as {names or 'your admin'} and enrol TOTP and a passkey if the account has none"
        gone = (
            ""
            if self.bootstrap_present()
            else f"The {BOOTSTRAP_SECRET} file is gone, so only the check of both factors and "
            f"the deletion of {BOOTSTRAP_ADMIN} remain. "
        )
        self.tools.say(
            f"{gone}Your part, in the browser: open {ADMIN_URL}/admin/ and sign in {who}. Then "
            "sign out and sign in once more. It worked when that second sign-in asked for the "
            "TOTP code and the account page lists a passkey. Both must sit on the same person."
        )
        self.typed(self.tools.ask, "Press Enter when your admin has TOTP and a passkey. ")
        token = self.admin_token()  # the browser part outlives a master token (60 s)
        self.require_second_admin_with_both_factors(token)
        for user in self.user_named(token, BOOTSTRAP_ADMIN):
            self.admin_call(token, "DELETE", f"/users/{user['id']}")
        (self.secrets_dir / BOOTSTRAP_SECRET).unlink(missing_ok=True)

    # --- the run --------------------------------------------------------------------------

    def backup_is_settled(self) -> bool:
        return self.tools.backup_is_set_up() or self.database_volume_exists()

    def steps(self) -> list[Step]:
        return [
            Step(
                "1",
                "backup",
                self.backup_is_settled,
                self.confirm_no_backup,
                "Keycloak will hold every login. While hal backup is not set up on this PC, you "
                "decide once whether to go live without a Keycloak backup. Nothing is asked once "
                "hal backup is set up (password file and repository exist) or Keycloak's "
                "database exists.",
            ),
            Step(
                "2",
                "secrets",
                self.secrets_are_complete,
                self.create_secrets,
                "Create the three random passwords Keycloak and its database need, in "
                "~/.secrets/keycloak/. They are never printed and an existing file is never "
                "replaced.",
            ),
            Step(
                "2b",
                "client secrets",
                self.client_secrets_are_complete,
                self.create_client_secrets,
                "Create one random secret per confidential app client that compose.yaml names, in "
                "~/.secrets/keycloak/clients/. Only a missing file is created; they are never "
                "printed and an existing file is never replaced.",
            ),
            Step(
                "3",
                "keycloak start",
                self.keycloak_answers,
                self.start_keycloak,
                "Start Keycloak with a temporary admin, only so the realms can be applied once; "
                "that admin is deleted in step 7.",
            ),
            Step(
                "4a",
                "master on the admin entrypoint",
                self.master_is_moved,
                self.move_master,
                "Move the admin realm (master) to http://localhost:8090, the door that only this "
                "PC can reach. The apply cannot do this itself, because the move changes the "
                "address of the token it signs in with.",
            ),
            Step(
                "4b",
                "realms applied",
                self.realm_import_completed,
                self.apply_realms,
                "Apply keycloak/master.yaml and keycloak/realm.yaml: the realms are code, and this "
                "is the first time that code becomes a running Keycloak.",
            ),
            Step(
                "5",
                "edge without the overlay",
                self.edge_runs_without_overlay,
                self.start_edge,
                "Restart Keycloak without the temporary admin and start the edge (Traefik) with "
                "both doors, then wait until it answers.",
            ),
            Step(
                "6",
                "admin created",
                self.admin_exists,
                self.create_admin,
                "You type a user name and a first password (hidden, twice); the script creates "
                "your master admin with the realm role admin. The password is permanent and goes "
                "only to Keycloak on this PC. In the browser you then only enrol TOTP and a "
                "passkey.",
            ),
            Step(
                "7",
                "bootstrap retired",
                self.bootstrap_retired,
                self.retire_bootstrap,
                "In the browser you sign in as your admin, enrol TOTP and add a passkey. Only "
                "when one admin has both does the script delete the temporary admin and its "
                "password file.",
            ),
        ]

    def check(self) -> int:
        """`--check`: exit 0 set up, 1 not set up (one line says what is missing), 2 cannot tell.
        Reads go-live's durable trace only: it asks nothing, prints no secret, changes nothing."""
        prefix = "keycloak/go-live --check"
        try:
            if not self.secrets_are_complete():
                reason = "no secrets in ~/.secrets/keycloak; run keycloak/go-live"
            elif self.bootstrap_present():
                reason = (
                    f"{BOOTSTRAP_SECRET} still exists, so steps 6-7 (retire {BOOTSTRAP_ADMIN}) "
                    "are not done; run keycloak/go-live"
                )
            elif missing_clients := self.missing_client_ids():
                client_id = missing_clients[0]
                reason = (
                    f"the secret of client {client_id} is missing "
                    f"(~/.secrets/keycloak/{CLIENT_SECRETS_DIR}/{client_id}); run keycloak/go-live"
                )
            else:
                self.tools.say(f"{prefix}: set up")
                return 0
        except DockerDidNotAnswer as failure:
            self.tools.say(self.scrubbed(str(failure)))
            return 2
        except StepFailure as failure:
            reason = self.scrubbed(str(failure))
        except Exception as unexpected:  # the one boundary, as in run(): never a traceback
            self.tools.say(f"unexpected answer ({type(unexpected).__name__})")
            return 2
        self.tools.say(reason)
        return 1

    def run(self) -> int:
        current = "start"
        try:
            reason = self.switched_off_reason()
            if reason:
                self.tools.say(f"go-live: refused, {reason}")
                return 1
            for step in self.steps():
                current = step.name
                if step.is_done():
                    continue
                self.tools.say(f"Step {step.number}, {step.name}: {step.why}")
                step.do()
                self.tools.say(f"go-live: {step.name} done")
        except (StepFailure, switches.SwitchError) as failure:
            self.tools.say(f"go-live FAILED at {current}: {self.scrubbed(str(failure))}")
            return 1
        except Exception as unexpected:  # the one boundary: a failure is a line, never a traceback
            self.tools.say(
                f"go-live FAILED at {current}: unexpected answer ({type(unexpected).__name__})"
            )
            return 1
        except KeyboardInterrupt:
            self.tools.say(f"go-live FAILED at {current}: interrupted")
            return 1
        self.tools.say("go-live: Keycloak is live on this PC.")
        self.tools.say(NEXT_STEP)
        return 0


def main() -> int:
    go_live = GoLive(
        Tools(),
        Path.home() / ".secrets" / "keycloak",
        switches.Switches(switches.default_state_directory()),
    )
    steps = "\n".join(
        textwrap.fill(f"{step.number}. {step.name}: {step.why}", subsequent_indent="   ")
        for step in go_live.steps()
    )
    parser = argparse.ArgumentParser(
        description=__doc__.splitlines()[0],
        epilog=(f"Steps, each skipped when already done:\n{steps}\n\n{NEXT_STEP}"),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="ask nothing and change nothing: exit 0 when go-live is finished, 1 when not "
        "(one line says what is missing), 2 when Docker did not answer or answered "
        "something it cannot read",
    )
    arguments = parser.parse_args()
    return go_live.check() if arguments.check else go_live.run()


if __name__ == "__main__":
    sys.exit(main())
